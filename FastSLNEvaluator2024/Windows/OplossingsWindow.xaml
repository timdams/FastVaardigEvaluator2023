<Window x:Class="FastSLNEvaluator2024.Windows.OplossingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FastSLNEvaluator2024.Windows"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="OplossingsWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <!-- Header -->
            <RowDefinition></RowDefinition>
            <!-- Main -->
            <RowDefinition Height="auto"></RowDefinition>
            <!-- footer -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Name="gridHeader">
            <DockPanel>
                <Menu DockPanel.Dock="Top">
                    <ui:MenuItem Header="_Load" Click="Load_MenuItem_Click"></ui:MenuItem>
                    <ui:MenuItem Header="Generate" Name="genExampleJson" Click="genExampleJson_Click"></ui:MenuItem>
                </Menu>
            </DockPanel>
        </Grid>
        <Grid Grid.Row="1">
            <ListBox Name="lbExamen" ItemsSource="{Binding Opgaves}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Beschrijving}"></TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
